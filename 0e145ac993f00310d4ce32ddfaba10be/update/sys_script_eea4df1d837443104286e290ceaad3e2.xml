        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var user = gs.getUser();
    if (user.hasRole('x_431220_ciclo.user') && !user.hasRole('x_431220_ciclo.admin')) {
        var grupoSGCC = "Subdirección General de Coordinación de la Contratación [SGCC]";
        var grupoHacienda = "Titular del Área de Gobierno de Hacienda (o Delegado/a)";
        if (!user.isMemberOf(grupoSGCC) && !user.isMemberOf(grupoHacienda)) {
            var userCompany = user.getCompanyID();
            if (userCompany) {
                current.addQuery('company', userCompany);
            } else {
                current.addQuery('company', 'none'); 
            }
        }
    }
})(current, previous);]]></script>
